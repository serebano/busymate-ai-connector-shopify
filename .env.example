# ── Shopify (OWNER-GATED — issued in the Shopify Partner Dashboard) ─────────────
# Create the app in Partners > Apps, then `shopify app config link` / `shopify app env pull`.
SHOPIFY_API_KEY=REPLACE_WITH_PARTNER_APP_CLIENT_ID
SHOPIFY_API_SECRET=REPLACE_WITH_PARTNER_APP_CLIENT_SECRET
SHOPIFY_APP_URL=https://shopify.busymate.ai
SCOPES=read_products,read_content,read_orders,read_customers,read_fulfillments,write_orders,read_returns,write_returns
SHOPIFY_API_VERSION=2026-07
# The app handle from shopify.app.toml (`handle`). Drives the Shopify Managed
# Pricing page URL: /store/<store>/charges/<handle>/pricing_plans.
SHOPIFY_APP_HANDLE=busymate-ai

# ── App's OWN Postgres (independent failure domain — NOT the bmai/Supabase DB) ──
DATABASE_URL=postgresql://bmai_shopify:CHANGE_ME@localhost:5432/bmai_shopify?schema=public

# ── Busymate AI integration (MCP contracts only — never a backdoor DB write) ───
# Canonical MCP host. OAuth 2.1 (DCR + PKCE) client credentials for the app's
# provisioning identity live in the app's secret store, resolved at runtime.
# One Busymate AI MCP surface owns both proof-of-shop lifecycle and tenant
# management. Busymate DevTools is a separate product and is never called.
BMAI_MGMT_MCP_URL=https://busymate.ai/mcp
# Proof-of-shop: the HMAC secret the app signs the shop with (== the Busymate AI
# platform Vault SHOPIFY_PARTNER_HMAC). Authorizes partner tools without an operator credential.
BMAI_PARTNER_PROOF_SECRET=REPLACE_WITH_SHARED_HMAC_SECRET
# One durable rotating OAuth refresh credential, bound to busymate.ai/mcp.
# It rotates and is persisted to the BmaiCredential table.
BMAI_MGMT_CLIENT_ID=REPLACE_WITH_BMAI_DCR_CLIENT_ID             # resource busymate.ai/mcp
BMAI_MGMT_REFRESH_TOKEN=REPLACE_WITH_BMAI_REFRESH_TOKEN
# OPTIONAL static bootstrap access token (testing only; refresh creds win).
BMAI_MGMT_TOKEN=
# The embed/serving origin for the white-label widget. Every store serves at
# <slug>.busymate.ai off the platform apex cert; the storefront origins go into
# the tenant's published embed-origin allowlist, not tenant_domains.
BMAI_EMBED_ORIGIN=https://busymate.ai

# ── The per-store Shopify Admin MCP connector (delegation) ─────────────────────
# Busymate AI mints a short-lived HS256 "actor token" per delegated tools/call and
# presents it as the MCP Authorization: Bearer. This host VERIFIES it (app/mcp/actorToken.ts):
# it holds ONE shared master and DERIVES the per-(tenant,connector) verifier secret
# at verify time — HMAC-SHA256(master, "bmai-support-actor:v2\n"+tenantId+"\n"+connectorId).
#
# BMAI_SUPPORT_ACTOR_MASTER — the shared master, base64url/utf8, >=32 bytes. It is the
# SAME value Busymate AI signs actor tokens with (the platform's V2_SUPPORT_ACTOR_TOKEN_SECRET);
# provisioned value-blind into the app's deploy env. UNSET/short => the app cannot verify
# actor tokens (fail-closed: every delegated tools/call is refused). Never logged.
BMAI_SUPPORT_ACTOR_MASTER=REPLACE_WITH_SHARED_ACTOR_MASTER_MIN_32_BYTES
#
# BMAI_ALLOW_HEADER_CALLER — DEV/TEST ONLY. When on (1/true), the legacy unverified
# x-bmai-shop header caller path is accepted; default is OFF in production (NODE_ENV
# =production) so prod trusts the verified actor token ONLY. Leave UNSET in prod.
BMAI_ALLOW_HEADER_CALLER=
#
# DEPRECATED (superseded by the derived-per-connector model above): a single static
# HMAC secret is no longer used by the verifier — each (tenant,connector) gets a
# unique derived secret from BMAI_SUPPORT_ACTOR_MASTER. Kept only for legacy docs.
BMAI_CONNECTOR_HMAC_SECRET=REPLACE_WITH_32B_RANDOM_HEX

# ── Identified launch (storefront customer → order scoping) ────────────────────
# ES256 PRIVATE key (PKCS#8 PEM, single line with \n). The PUBLIC half is served
# at /.well-known/jwks.json and registered as the tenant's visitor IdP.
LAUNCH_SIGNING_KEY=REPLACE_WITH_ES256_PRIVATE_KEY_PEM
LAUNCH_KEY_ID=bmai-shopify-launch-1

# ── Encryption at rest (PCD attestation — app/lib/fieldCipher.ts) ──────────────
# 32-byte key (base64 or 64-char hex) that encrypts the credential/PII columns at
# rest: Session.accessToken + email, BmaiCredential.refreshToken (AES-256-GCM).
# Generate: `openssl rand -base64 32`. Held only in the host secret env; value-blind.
# UNSET/invalid => production sensitive writes fail closed; dev/CI can run without a key.
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
