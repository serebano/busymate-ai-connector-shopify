{
  "name": "busymate-ai-shopify",
  "private": true,
  "version": "0.1.17",
  "description": "Busymate AI for Shopify — the official Shopify App Store app, and an open reference for connecting any platform to Busymate AI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "NODE_ENV=production react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "config:push": "shopify app config push",
    "deploy": "shopify app deploy",
    "start": "NODE_ENV=production react-router-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "drift-check": "node scripts/drift-check.mjs",
    "listing:sync": "node scripts/sync-listing-from-db.mjs",
    "tokens:cycle": "tsx scripts/cycle-offline-tokens.ts",
    "tokens:audit": "tsx scripts/offline-token-audit.ts",
    "webhooks:probe": "tsx scripts/webhook-probe.ts",
    "kb:retrain": "tsx scripts/retrain-shops.ts",
    "kb:freshness": "tsx scripts/kb-freshness.ts",
    "tenants:reconcile": "tsx scripts/reconcile-tenants.ts",
    "prisma": "prisma",
    "setup": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate deploy",
    "kb:reingest": "tsx scripts/kb-reingest.ts",
    "test:reingest-sql": "node --test scripts/__tests__/reingest-sql.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/fs-routes": "^7.1.1",
    "@react-router/node": "^7.1.1",
    "@react-router/serve": "^7.1.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-api": "14.0.1",
    "@shopify/shopify-app-react-router": "2.1.0",
    "@shopify/shopify-app-session-storage-prisma": "10.0.1",
    "isbot": "^5.1.0",
    "jose": "^5.9.6",
    "morgan": "^1.12.1",
    "pg": "8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.2",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  }
}
