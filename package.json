{
  "name": "busymate-ai-shopify",
  "private": true,
  "version": "0.1.14",
  "description": "Busymate AI for Shopify — the official Shopify App Store app, and an open reference for connecting any platform to Busymate AI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "NODE_ENV=production react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "config:push": "shopify app config push",
    "deploy": "shopify app deploy",
    "start": "NODE_ENV=production react-router-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "drift-check": "node scripts/drift-check.mjs",
    "listing:sync": "node scripts/sync-listing-from-db.mjs",
    "tokens:cycle": "tsx scripts/cycle-offline-tokens.ts",
    "kb:retrain": "tsx scripts/retrain-shops.ts",
    "tenants:reconcile": "tsx scripts/reconcile-tenants.ts",
    "prisma": "prisma",
    "setup": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/fs-routes": "^7.1.1",
    "@react-router/node": "^7.1.1",
    "@react-router/serve": "^7.1.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-api": "14.0.1",
    "@shopify/shopify-app-react-router": "2.1.0",
    "@shopify/shopify-app-session-storage-prisma": "10.0.1",
    "isbot": "^5.1.0",
    "jose": "^5.9.6",
    "morgan": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@react-router/dev": "^7.1.1",
    "@shopify/api-codegen-preset": "^1.1.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "happy-dom": "^20.14.5",
    "prisma": "^6.19.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ]
}
