// Busymate AI for Shopify — the app's OWN Postgres (independent failure domain;
// NOT the bmai/Supabase control plane, which is reached only via MCP).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shopify session storage adapter table (@shopify/shopify-app-session-storage-prisma).
/// Holds the EXPIRING offline access token (+ refresh token) per shop used by the Admin GraphQL connector.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  /// Expiring offline tokens (#2110): the rotating refresh credential (encrypted at rest) + its expiry.
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/// One row per installed store — maps a Shopify shop to its bmai white-label tenant.
model ShopTenant {
  shop           String   @id // <name>.myshopify.com
  bmaiTenantId   String?  // tenants.id in the bmai control plane (via MCP)
  slug           String?  @unique // <slug>.busymate.ai serving host
  connectorId    String?  // mcp_servers row id for this store's Admin connector
  /// The tenant's visitor identity provider registered for this store's launch JWT
  /// (#2132): re-targeted on every idempotent lifecycle run, never re-created.
  identityProviderId String?
  provisionState String   @default("pending") // pending | provisioning | published | suspended | error
  provisionError String?
  /// A published tenant whose registered order tools / customer sign-in are NOT in
  /// the published revision (#2132) — surfaced on Home + Store connection.
  provisionWarning String?
  /// Set when the resolution meter's MCP reads (list_tenant_conversations /
  /// list_tenant_interventions) are refused with tenant_management_denied —
  /// this shop's `bmaiTenantId` no longer resolves to a live, admin-authorized
  /// tenant (deprovisioned/archived on the platform side, drifted from this
  /// row's stale provisionState). Edge-triggered: set/logged ONCE on the first
  /// denial, cleared/logged once on recovery — never re-logged every hourly
  /// meter run (#19/#2835). See app/lib/resolutionLedger.server.ts.
  tenantUnreachableAt DateTime?
  customDomain   String?  // storefront custom domain, added to the embed-origin allowlist
  publishedAt    DateTime?
  /// Training state (#2110 grounding): what the assistant was last trained on via
  /// publish_tenant_runtime.knowledge_sources (app/lib/kbTrain.ts). Counts are the
  /// items INCLUDED; *Total = items the store has (truncated when smaller).
  kbTrainedAt     DateTime?
  kbError         String?
  kbProducts      Int?
  kbPolicies      Int?
  kbPages         Int?
  kbChars         Int?
  kbTruncated     Boolean?
  kbProductsTotal Int?
  kbPagesTotal    Int?
  /// Set when the shop must no longer be re-trained (#52): `uninstalled`
  /// (app/uninstalled) or `shop_not_found` (the knowledge-freshness backstop saw
  /// Shopify answer 404 on both admin and storefront — a deleted store). Cleared
  /// on the next afterAuth (a reinstall). Inactive shops are excluded from the
  /// backstop and from the freshness health check.
  inactiveAt      DateTime? @db.Timestamptz
  inactiveReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  billing BillingState?
  reingestQueue KbReingestQueue?
}

/// Merchant-facing billing (Shopify Billing API). DISTINCT from the internal
/// bmai usage_events cost ledger — two ledgers, never conflated.
model BillingState {
  shop                 String   @id
  subscriptionId       String?  // AppSubscription GID
  plan                 String   @default("starter")
  status               String   @default("inactive") // inactive | pending | active | cancelled | frozen
  usageLineItemId      String?  // AppUsageRecord line item GID (capped usage)
  cappedAmountCents    Int      @default(5000) // merchant spend cap; widget NEVER disabled at cap
  currency             String   @default("USD")
  lastMeteredCursor    String?  // idempotent cursor into bmai usage_events
  updatedAt            DateTime @updatedAt

  tenant ShopTenant @relation(fields: [shop], references: [shop], onDelete: Cascade)
  deliveries MeterDelivery[]
}

/// Singleton row holding the DURABLE bmai provisioning OAuth refresh credential.
/// The OAuth refresh token ROTATES on every use (the bmdev edge revokes the prior
/// one), so the current value must be PERSISTED here — not only seeded from env —
/// or a restart after a rotation would present a revoked token. Value-blind: never
/// logged. One row, keyed by a fixed id.
model BmaiCredential {
  id           String   @id @default("provision")
  clientId     String
  refreshToken String
  updatedAt    DateTime @updatedAt
}

/// ES256 launch-key metadata for identified launch (the storefront visitor IdP).
/// The PRIVATE key lives in a secret (env/vault), never the DB — only its kid + JWKS-published public JWK here.
model LaunchKey {
  kid        String   @id
  publicJwk  String   // serialized public JWK, served at /.well-known/jwks.json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

/// The AI-resolution ledger — ONE row per (tenant, conversation) ever counted as
/// a billable resolution (#19/#2835). Idempotency boundary for the producer in
/// app/lib/resolutionLedger.server.ts: a session id can be committed at most
/// once per tenant (`@@unique`), so a re-scan of the same recent-conversations
/// window never double-counts. Keyed by the bmai `tenantId` (not `shop`) because
/// that is what `readResolutions(tenantId, cursor)` already carries — no shop
/// lookup needed on the hot path. `occurredAt` = the conversation's
/// `lastActiveAt` at the moment it qualified (the outbox evidence range), never
/// processing time.
model MeteredResolution {
  id         String   @id @default(cuid())
  tenantId   String
  sessionId  String
  occurredAt DateTime @db.Timestamptz
  countedAt  DateTime @default(now()) @db.Timestamptz

  @@unique([tenantId, sessionId])
  @@index([tenantId, countedAt])
}

/// Unwired prepared-batch delivery core. accepted means ingestion, never billed.
model MeterDelivery {
  id          String @id
  shop        String
  payloadHash String
  payload     Json
  state       String @default("pending")
  leaseToken  String?
  leaseUntil  DateTime? @db.Timestamptz
  acceptedAt  DateTime? @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz
  billing     BillingState @relation(fields: [shop], references: [shop], onDelete: Cascade)
  @@unique([shop, payloadHash])
  // Partial unique pending-shop index is maintained in the SQL migration.
}

/// One row per knowledge-freshness backstop run (#52, scripts/kb-freshness.ts):
/// the run log with counts, the in-flight lease (finishedAt NULL), and the
/// evidence-of-success the health check demands (`/api/kb/health` is RED when no
/// run has FINISHED recently — the absence of success is the alarm).
model KbFreshnessRun {
  id          String    @id @default(cuid())
  trigger     String    @default("timer")
  startedAt   DateTime  @default(now()) @db.Timestamptz
  finishedAt  DateTime? @db.Timestamptz
  ok          Boolean?
  considered  Int?
  active      Int?
  due         Int?
  trained     Int?
  failed      Int?
  inactivated Int?
  skipped     Int?
  deferred    Int?
  detail      Json?

  @@index([finishedAt])
}

/// Durable webhook requests, independent of billing. Bound but unprovisioned shops remain pending.
model KbReingestQueue {
  shop String @id
  requested Int @default(0)
  completed Int @default(0)
  dueAt DateTime @default(now()) @db.Timestamptz
  firstPendingAt DateTime @default(now()) @db.Timestamptz
  attempts Int @default(0)
  leaseToken String?
  leaseGeneration Int?
  leaseTenantId String?
  leaseUntil DateTime? @db.Timestamptz
  lastErrorCode String?
  updatedAt DateTime @default(now()) @db.Timestamptz
  receipts KbReingestReceipt[]
  tenant ShopTenant @relation(fields: [shop], references: [shop], onDelete: Cascade)
  @@index([dueAt])
}
model KbReingestReceipt {
  shop String
  webhookId String
  receivedAt DateTime @default(now()) @db.Timestamptz
  queue KbReingestQueue @relation(fields: [shop], references: [shop], onDelete: Cascade)
  @@id([shop, webhookId])
  @@index([receivedAt])
}
model KbReingestWorkerState {
  id Int @id @default(1)
  listenerConnected Boolean @default(false)
  startedAt DateTime? @db.Timestamptz
  finishedAt DateTime? @db.Timestamptz
  claimed Int @default(0)
  failed Int @default(0)
}
