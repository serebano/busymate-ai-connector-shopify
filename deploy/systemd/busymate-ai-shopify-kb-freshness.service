[Unit]
# Knowledge-freshness BACKSTOP (#52): re-train every active shop whose knowledge
# is older than 72 h (Shopify has no webhook for policies or pages), mark deleted
# stores inactive, log the run (KbFreshnessRun). One-shot; the timer below runs it.
# Health: https://store.busymate.ai/api/kb/health (503 when any active shop > 96 h
# or no run finished in 14 h) — judged from outside the box by busymate-ai's
# v2-infra-deadman `shopify-kb` arm.
Description=Busymate AI for Shopify - knowledge freshness backstop (re-train > 72 h)
After=network-online.target postgresql.service busymate-ai-shopify.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/busymate-ai-shopify
Environment=NODE_ENV=production
# Read by systemd as root before dropping to deploy; never on argv.
EnvironmentFile=/etc/busymate-ai-shopify/env
ExecStart=/opt/busymate-ai-shopify/node_modules/.bin/tsx scripts/kb-freshness.ts
TimeoutStartSec=1800
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
