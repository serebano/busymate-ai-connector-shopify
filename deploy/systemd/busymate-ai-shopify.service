[Unit]
# Busymate AI for Shopify — React Router 7 SSR app server.
# Serves the embedded admin UI + /mcp connector + /identity + JWKS at
# shopify.busymate.ai (nginx TLS terminates and reverse-proxies to 127.0.0.1:$PORT).
Description=Busymate AI for Shopify (React Router SSR, :3970)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/busymate-ai-shopify
# react-router-serve; binds 127.0.0.1 only (nginx is the public edge).
Environment=NODE_ENV=production
Environment=PORT=3970
Environment=HOST=127.0.0.1
# Secrets + DATABASE_URL + Shopify keys live here (mode 0600 root:deploy).
EnvironmentFile=/etc/busymate-ai-shopify/env
ExecStart=/usr/bin/node node_modules/@react-router/serve/dist/cli.js ./build/server/index.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
